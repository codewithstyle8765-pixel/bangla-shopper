# Magento GraphQL Endpoint
NEXT_SERVER_MAGENTO_ENDPOINT=http://192.168.15.123/m248p4/pub/graphql
NEXT_PUBLIC_BASE_URL=http://192.168.15.123/m248p4/pub/
# Product image host, only if it differs from <NEXT_PUBLIC_BASE_URL>/media/ (e.g. a CDN)
MAGENTO_MEDIA_URL=

# Store Configuration
DEFAULT_STORE_CODE=default

# NextAuth (required). Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Magento "Customer Token Lifetime" in hours (Stores > Configuration > Services > OAuth).
# Customers stay signed in this long; keep it equal to the Magento setting (e.g. 168 = 7 days).
MAGENTO_TOKEN_LIFETIME_HOURS=168

# Shared secret for the Magento cache webhook (POST /api/revalidate, header x-revalidate-secret)
REVALIDATION_SECRET=

# Data source: true = mock data (src/mocks), false = live Magento GraphQL API
FALLBACK_MODE=true

# Public storefront URL (canonical links, structured data)
NEXT_PUBLIC_SITE_URL=https://www.banglashoppers.com
